# UPSC AI PRO - frontend configuration template (placeholders only).
#
# Copy to `.env.local` (never commit it). Every VITE_* value is compiled into
# the public JavaScript bundle and is readable by anyone: NEVER put API keys,
# tokens, passwords or any other secret here. Provider keys live only in the
# backend `.env` (see ../.env.example).

# Backend API base URL, including /api/v1.
# - Development: optional; defaults to http://127.0.0.1:8000/api/v1.
# - Production build: REQUIRED. The build succeeds without it, but the app then
#   fails at runtime with "Backend API URL is not configured".
# The backend's CORS_ORIGINS must include this frontend's origin.
VITE_API_BASE=http://127.0.0.1:8000/api/v1
