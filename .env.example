# UPSC AI PRO - backend configuration template (placeholders only).
#
# Copy to `.env` (never commit `.env`) and fill in values locally or in the
# hosting dashboard. Every secret below is intentionally EMPTY. Secrets belong
# to the backend only - never put any of them in a frontend VITE_* variable.
# Names match src/core/config.py (case-insensitive). Unset values use the code
# defaults noted in comments; unlisted settings keep their code defaults.

# --------------------------------------------------------------------------- #
# Environment and auth
# --------------------------------------------------------------------------- #
# "production" | "staging" | "development". Production refuses to start with a
# missing/short JWT_SECRET; non-production falls back to an ephemeral secret
# (all sessions end on restart).
ENV=development
DEBUG=false
# Secret, >= 32 random characters. Generate a fresh value; never reuse an old one.
JWT_SECRET=

# --------------------------------------------------------------------------- #
# Database
# --------------------------------------------------------------------------- #
# Empty => local SQLite. Production: Postgres URL (contains a password - secret).
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# --------------------------------------------------------------------------- #
# CORS / links
# --------------------------------------------------------------------------- #
# Exact frontend origin(s), JSON list or comma-separated. "*" is dropped.
# The code default list does NOT include 127.0.0.1:5193 or any Vercel origin.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Used to build password-reset / verification links (no trailing slash).
# Code default is http://localhost:8501 (old Streamlit port).
FRONTEND_URL=http://127.0.0.1:5173
# Production (set in the Render dashboard, not here; placeholders):
#   ENV=production
#   CORS_ORIGINS=https://<your-frontend>.vercel.app
#   FRONTEND_URL=https://<your-frontend>.vercel.app
#   ADMIN_EMAILS=<admin-email>
# The frontend build (Vercel) then needs
#   VITE_API_BASE=https://<your-backend>.onrender.com/api/v1

# --------------------------------------------------------------------------- #
# LLM providers (Mentor and all other AI features)
# --------------------------------------------------------------------------- #
# The app builds a chain from whichever keys are present:
#   main: gemini LLM_MODEL -> gemini LLM_FAST_MODEL -> groq GROQ_MODEL
#   fast: gemini LLM_FAST_MODEL -> groq GROQ_FAST_MODEL -> gemini LLM_MODEL
# With BOTH keys empty, AI requests fail ("No LLM provider available").
# Provider/model choice is NOT decided yet - defaults shown are the code's.
GOOGLE_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# LLM_FAST_MODEL=gemini-2.5-flash-lite
# LLM_TEMPERATURE=0.3
# LLM_MAX_RETRIES=1
# Max output tokens per Gemini call (1..65536, code default 4096; invalid values
# stop startup). Applies to main, fast and fallback Gemini models. NOT a total
# request-cost cap: retries, provider fallback and several agent/LLM calls per
# request (tool loop, router, critic, ...) each add their own input + output tokens.
LLM_MAX_OUTPUT_TOKENS=4096
# Per-call Gemini network timeout in SECONDS (0 < value <= 600, default 45).
# Covers connecting, waiting for a response (incl. a streamed reply to start)
# and each gap between streamed chunks. NOT a whole-request deadline: a reply
# that keeps streaming is not cut off, and one request can make several calls
# (routing, agent/tool rounds), each with its own timeout. A timed-out call is
# not retried and does not fall back to another model; the Mentor chat shows a
# "did not respond in time" message and the request ends.
LLM_REQUEST_TIMEOUT_SECONDS=45
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# ENABLE_PROVIDER_FALLBACK=true

# Optional OpenAI-compatible provider - leave empty (off).
# OPENAI_COMPAT_* / GROQ_FALLBACK_MODELS are defined in config.py but no
# consumer was found in src/ during the 2026-10-29 review.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODELS=

# --------------------------------------------------------------------------- #
# Embeddings / vector store (Mentor knowledge_base_search, uploads, NCERT)
# --------------------------------------------------------------------------- #
# gemini (default; uses GOOGLE_API_KEY, network) | local (needs fastembed, not
# installed) | ollama | openai_compat
EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=models/gemini-embedding-001
OPENAI_EMBED_BASE_URL=
OPENAI_EMBED_API_KEY=
OPENAI_EMBED_MODEL=
# Vector store: set QDRANT_URL (remote) OR QDRANT_PATH (embedded local), never
# both (startup fails). Both empty => local Chroma in CHROMA_PERSIST_DIR (Chroma
# is NOT installed in this project's environment).
QDRANT_URL=
QDRANT_API_KEY=
# Embedded local Qdrant folder (in-process, no server, no network). SINGLE
# PROCESS ONLY: the folder is locked by the running app; a second worker, an
# RQ worker or a script on the same path will fail. For local dev/previews.
QDRANT_PATH=
# Size Gemini embeddings are pinned to; also used to create/validate Qdrant
# collections without a probe embedding call (default 768; 0 = no pinning).
# GEMINI_EMBEDDING_DIM=768
# CHROMA_PERSIST_DIR=chroma_db
# NCERT_DATA_DIR=data/ncert   (local folder; used only when R2 is not configured)

# --------------------------------------------------------------------------- #
# NCERT PDFs from a PRIVATE Cloudflare R2 bucket (production)
# --------------------------------------------------------------------------- #
# Set all four to read <prefix><class>/<subject>/<chapter>.pdf from R2; set none
# to use NCERT_DATA_DIR. Setting only some marks the NCERT library unavailable.
# PDFs are downloaded server-side only; no public/presigned URLs are created.
# Use an Object-Read-only API token scoped to the bucket.
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# NCERT_R2_PREFIX=ncert/
# NCERT_MAX_PDF_MB=50
# NCERT_CATALOG_TTL_SECONDS=600

# --------------------------------------------------------------------------- #
# Web search (Mentor web_search tool)
# --------------------------------------------------------------------------- #
# WEB_SEARCH_ENABLED=false => neither Tavily nor the keyless DuckDuckGo
# fallback is contacted (Mentor web_search tool, RAG web fallback, planner date
# lookup, monthly CA ingest). Code default is true; keep false for the pilot.
# With true and an empty TAVILY_API_KEY, DuckDuckGo is still called.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=

# --------------------------------------------------------------------------- #
# Email (SMTP)
# --------------------------------------------------------------------------- #
# Links/tokens are never logged.
# - Production (ENV=production, or ENV empty with DEBUG=false): with
#   REQUIRE_EMAIL_VERIFICATION=true and SMTP unset the backend REFUSES TO START;
#   register/forgot-password/resend-verification return 503 without SMTP.
# - Non-production with SMTP unset: verification is auto-disabled and nothing
#   is sent. Local-development convenience only, NOT a production policy.
#   To test the real flow locally, use dummy SMTP_* values with a capture stub
#   (e.g. the out-of-repo preview_backend.py).
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Secret (e.g. a provider app password).
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --------------------------------------------------------------------------- #
# Cache / rate limiting (Upstash Redis REST) - empty => off / in-process
# --------------------------------------------------------------------------- #
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# RESPONSE_CACHE_ENABLED=true
# RESPONSE_CACHE_SEMANTIC=true   # embeds each question -> extra embedding calls
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_PERIOD=60
# AUTH_RATE_LIMIT_REQUESTS=10
# AUTH_RATE_LIMIT_PERIOD=300

# Background jobs: empty REDIS_URL => in-process "thread" backend.
REDIS_URL=

# --------------------------------------------------------------------------- #
# Observability - empty => off
# --------------------------------------------------------------------------- #
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --------------------------------------------------------------------------- #
# Optional / extra-cost features (code defaults shown; keep off)
# --------------------------------------------------------------------------- #
COHERE_API_KEY=
# RERANK_ENABLED=false
# MULTI_QUERY_ENABLED=false
# HYDE_ENABLED=false
# REFLECTION_ENABLED=false
# PLAN_EXECUTE_ENABLED=false
# PYQ_VERIFY_ENABLED=false
# HITL_ENABLED=false
# EXPERIMENTS_ENABLED=true

# Admin allowlist for the cost dashboard (JSON list or comma-separated).
ADMIN_EMAILS=

# Running streams re-check their session at most this often (seconds).
# STREAM_SESSION_CHECK_SECONDS=5.0
